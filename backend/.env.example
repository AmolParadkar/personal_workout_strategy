# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by git: never commit real keys.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Public. Used together with a signed-in user's token, so access rules apply.
SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret key named backend-api (sb_secret_...)
# Bypasses all access rules: backend only, never in the website or in chat.
SUPABASE_SECRET_KEY=

# Supabase → Project Settings → API Keys → Secret key named mac-worker (sb_secret_...)
# Used only by the Mac worker (backend/worker/); never on Vercel.
MAC_WORKER_SECRET_KEY=

# Groq (cloud Qwen): console.groq.com → API Keys. Used by the Mac worker, and by the
# API on Vercel for quick plan generation (add it to the API's Vercel settings too).
# GROQ_MODEL only if the default is retired.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# YouTube Data API v3 (Mac worker only, not on Vercel): console.cloud.google.com → APIs → YouTube Data API v3 → Credentials.
YOUTUBE_API_KEY=

# Website addresses allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:8081

# Direct connectors (context/data-sources.md). Optional: a service can be
# connected only once its developer app's client ID and secret are set.
# Encrypts the services' access keys; make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later means everyone has to reconnect.
CONNECTOR_ENCRYPTION_KEY=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
