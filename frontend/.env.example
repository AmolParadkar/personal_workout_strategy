# Copy this file to frontend/.env and fill in the values.
# Only EXPO_PUBLIC_ variables reach the website, and anything in the
# website is visible to visitors, so only public values belong here.

# Supabase → Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
